rules_version = '2';

// Design note: vote "counts" are never stored as mutable counter fields.
// Each vote is its own document, owned by the user who wrote it, and every
// client tallies results by listening to the relevant subcollection live.
// Voting is also free-form: a visitor types the quantity they want (e.g.
// "4") next to a fixed unit label (e.g. "KG") rather than picking from a
// preset list, so there is no "options" subcollection to manage at all —
// just a bounded numeric `quantity` field on each vote document.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------------- admins ----------------
    // Admin membership is managed manually from the Firebase console / a trusted
    // backend. No client, including admins themselves, can grant admin via rules.
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------------- items ----------------
    match /items/{itemId} {
      allow read: if true;

      // Any signed-in user (anonymous included) can propose a new item,
      // but only with well-formed data and only as "active" immediately.
      allow create: if isSignedIn() && isValidNewItem();

      // Only admins can edit item metadata (name/question/unit) or deactivate/delete.
      allow update, delete: if isAdmin();

      function isValidNewItem() {
        let d = request.resource.data;
        return d.name is string && d.name.size() > 0 && d.name.size() <= 100 &&
          d.question is string && d.question.size() > 0 && d.question.size() <= 200 &&
          d.unit is string && d.unit.size() > 0 && d.unit.size() <= 20 &&
          d.active == true &&
          d.createdBy == request.auth.uid &&
          d.order is number;
      }
    }

    // ---------------- votes ----------------
    // votes/{itemId}/voters/{uid} — one doc per user per item; doc id IS the
    // user's own uid, which structurally prevents voting as someone else and
    // prevents more than one active vote per item per user. Read is public
    // so every client can tally live, anonymous results — the uid reveals
    // nothing beyond the fact that an anonymous session exists. The quantity
    // itself is bounded and type-checked so a client can't submit garbage.
    match /votes/{itemId}/voters/{uid} {
      allow read: if true;

      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.quantity is number &&
        request.resource.data.quantity > 0 &&
        request.resource.data.quantity <= 1000;

      allow delete: if false;
    }

    // ---------------- suggestions ----------------
    match /suggestions/{suggestionId} {
      allow read: if true;

      allow create: if isSignedIn() && isValidNewSuggestion();

      // Only admins change status (approve/reject). Suggestion "popularity"
      // is derived from the voters subcollection below, not a stored count.
      allow update: if isAdmin();
      allow delete: if isAdmin();

      function isValidNewSuggestion() {
        let d = request.resource.data;
        return d.name is string && d.name.size() > 0 && d.name.size() <= 60 &&
          d.status == 'pending' &&
          d.createdBy == request.auth.uid;
      }

      match /voters/{uid} {
        allow read: if true;
        // One doc per user per suggestion; re-"suggesting" becomes an update
        // (doc already exists) which is disallowed, so duplicates are
        // structurally rejected rather than silently double-counted.
        // `quantityText` is optional free text (e.g. "2 boxes") the admin
        // sees when deciding how to turn a suggestion into a real item.
        allow create: if isSignedIn() && request.auth.uid == uid && isValidSuggestionVoter();
        allow update, delete: if false;

        function isValidSuggestionVoter() {
          let d = request.resource.data;
          return !("quantityText" in d) || (d.quantityText is string && d.quantityText.size() <= 50);
        }
      }
    }
  }
}
